{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/package-lock.json)",
      "Read(/node_modules/**)",
      "Read(/build/**)",
      "Read(/src/legal/generated/**)",
      "Read(/.claude/skills/impeccable/scripts/**)",
      "Read(/src/assets/logo.png)",
      "Read(/supabase/.temp/**)",
      "Read(/.env*.local)"
    ]
  },
  "bashOutputMaxChars": 15000,
  "taskOutputMaxChars": 16000,
  "env": {
    "MAX_MCP_OUTPUT_TOKENS": "25000"
  }
}
