# Copy this to .env.local and fill in your values.

# Supabase — Dashboard > Project Settings > API
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here

# USDA FoodData Central — free key at https://fdc.nal.usda.gov/api-key-signup.html
# Omit to use DEMO_KEY (30 req/hr). A free registered key allows 1,000 req/hr.
REACT_APP_USDA_API_KEY=your-usda-key-here

# The production origin, e.g. https://app.crestsuite.com — used ONLY where a URL has to leave the
# browser: the printed Subscription Agreement quotes the Terms and Privacy URLs as the evidence of
# what a signed contract incorporated by reference. window.location.origin is right on screen and
# useless on paper — a contract citing localhost:3000 or a vercel.app preview is worthless.
# Unset, legalReadiness() reports it missing, the admin Legal tab and the agreement both refuse to
# look finished, and legalAbsoluteUrl() returns a visibly unfinished "[SET REACT_APP_SITE_ORIGIN]/…"
# rather than a plausible wrong domain. Set it in the Vercel project's env vars for production.
REACT_APP_SITE_ORIGIN=https://your-domain.com

# Web Push (HR Roster publish/shift-swap notifications) — public half of the VAPID keypair only.
# Generate with `npx web-push generate-vapid-keys`; the private half is a Supabase Edge Function
# secret (VAPID_PRIVATE_KEY), never here.
REACT_APP_VAPID_PUBLIC_KEY=your-vapid-public-key-here
