# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# production
/build

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Claude Code / impeccable — personal permissions and ephemeral runtime state, not shared project
# config. .claude/skills/, PRODUCT.md, DESIGN.md, .impeccable/design.json, .impeccable/live/,
# and .impeccable/critique/ ARE tracked — this only excludes the local-only files.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.impeccable/hook.cache.json
__pycache__/
*.pyc
.playwright-mcp/

# Critique/audit screenshot artifacts dumped in the repo root (viewport-named PNGs from
# /impeccable browser runs — 1440x900, 390x844). Root-scoped on purpose: every legitimate
# image asset lives under public/ or src/, so this cannot swallow one.
/*.png
